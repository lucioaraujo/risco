#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUILD_DIR="${TMPDIR:-/tmp}/risco-juce-release-build"
APP="$BUILD_DIR/risco_app_artefacts/Release/Risco"

cmake -S "$ROOT" -B "$BUILD_DIR" \
    -DCMAKE_BUILD_TYPE=Release \
    -DRISCO_BUILD_JUCE_APP=ON
cmake --build "$BUILD_DIR" --target risco_app --parallel 1
exec "$APP" "$@"
